# Production template. Copy to .env.production on the future host only.
# Never commit .env.production or real credentials.

POSTGRES_USER="infrared"
POSTGRES_PASSWORD="replace-with-a-strong-postgresql-password"
POSTGRES_DB="infrared"
DATABASE_URL="postgresql://infrared:replace-with-a-strong-postgresql-password@postgres:5432/infrared"
NEXT_PUBLIC_SITE_URL="https://your-domain.tn"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Keep false by default. On OVH, set true only when Next.js is reachable
# exclusively through Nginx on a non-public port, and Nginx always overwrites
# X-Real-IP with $remote_addr (never forwarding an X-Real-IP supplied by a client).
TRUST_PROXY_HEADERS="false"
# Set true only after administrator accounts have enrolled in TOTP 2FA.
REQUIRE_ADMIN_2FA="false"
GOOGLE_SITE_VERIFICATION="code-fourni-par-google-search-console"

# Storage backend for the current OVH deployment. "local" writes exclusively
# to /app/public/uploads, mounted from /var/www/infrared/uploads on the VPS.
# A future "r2" backend can be added to the storage abstraction; it is not
# configured or required now.
UPLOAD_STORAGE="local"

# Define these only before seeding a brand-new production database.
SEED_ADMIN_PASSWORD=""
SEED_COMMERCIAL_PASSWORD=""
SEED_DEVELOPER_PASSWORD=""

# SMTP can instead be configured securely from Admin > Parametres > E-mails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="InfraRed Optic-Store"
