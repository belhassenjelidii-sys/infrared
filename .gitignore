# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.transparent-stage/
/transparent-stage/
/scripts/bg-removal-test-output/
/scripts/pipeline-test-output/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# InfraRed — extra ignores
.env
.env.local
.env*.local
/prisma/*.db
/prisma/migrations/dev
.DS_Store

# Runtime uploads (do not commit customer/product media)
public/uploads/*
!public/uploads/.gitkeep
