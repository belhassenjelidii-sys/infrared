# InfraRed Optic-Store — template. Copy to .env and fill in real values.
# NEVER commit the real .env file (it is already in .gitignore).

DATABASE_URL="postgresql://infrared:infrared_dev_password@localhost:5432/infrared"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-48"

# Supabase Storage — required in production for image uploads (admin/commercial).
# SUPABASE_SERVICE_ROLE_KEY is server-only and must NEVER be exposed to the browser
# (it is only read from src/lib/supabase-storage.ts, a "server-only" module).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# ^ not currently used by any code path (uploads go through the service role
#   key only, server-side) — kept here in case you add client-side Supabase
#   features later. Safe to leave empty.
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket name (create it once in the Supabase dashboard, set to public read).
SUPABASE_STORAGE_BUCKET="product-images"

# Initial back-office accounts created by `npm run db:seed` / prisma/seed.ts.
# Set these before running the seed in any shared/production environment —
# if left unset, a random one-time password is generated and printed to the
# console instead (change it immediately from /admin/utilisateurs).
SEED_ADMIN_PASSWORD=""
SEED_COMMERCIAL_PASSWORD=""
SEED_DEVELOPER_PASSWORD=""

# SMTP legacy fallback — normally configure this from Admin → Paramètres → Envoi d'e-mails.
# Do not commit real credentials. Dashboard settings take precedence over these values.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="InfraRed Optic-Store"
SMTP_EHLO=""

# Google Places API (New) — used to sync each boutique's opening hours from Google
# Requires billing + Places API (New) enabled in Google Cloud.
# Catalogue seed safety. Leave false in normal use so running db:seed does
# not overwrite prices/photos you already edited in the dashboard. Set true
# only when you explicitly want to refresh those fields from src/lib/data.ts.
SEED_REFRESH_PRODUCT_IMAGES="false"
SEED_REFRESH_PRODUCT_PRICES="false"
