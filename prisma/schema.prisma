// InfraRed Optic-Store — Prisma schema
// Designed for PostgreSQL, compatible with a Supabase-hosted database.
// Run `npx prisma migrate dev` once DATABASE_URL is set in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMMERCIAL
  DEVELOPER
}

enum Target {
  HOMME
  FEMME
  MIXTE
  ENFANT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(COMMERCIAL)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  active      Boolean   @default(true)
  products    Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  logo     String?
  active   Boolean   @default(true)
  products Product[]

  @@map("brands")
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  reference    String         @unique
  description  String
  price        Decimal        @db.Decimal(10, 2)
  oldPrice     Decimal?       @db.Decimal(10, 2)
  discount     Int?
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  brandId      String
  brand        Brand          @relation(fields: [brandId], references: [id])
  color        String?
  shape        String?
  target       Target         @default(MIXTE)
  available    Boolean        @default(true)
  featured     Boolean        @default(false)
  isNew        Boolean        @default(false)
  isPromotion  Boolean        @default(false)
  archived     Boolean        @default(false)
  published    Boolean        @default(true)
  images       ProductImage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model StoreSettings {
  id         String  @id @default(cuid())
  logoUrl    String?
  phone      String?
  whatsapp   String?
  instagram  String?
  facebook   String?
  address    String?
  mapsUrl    String?
  hoursJson  String? // JSON-encoded opening hours

  // Homepage banner — editable from /admin/parametres
  heroTitle    String?
  heroSubtitle String?
  heroCtaLabel String?
  accentColor  String? // hex, e.g. "#E0122C"
  heroImageUrl String?
  categoryTitleSolaires String?
  categoryTitleOptiques String?
  categoryTitleNouveautes String?
  showPrices Boolean @default(true)

  @@map("store_settings")
}

model Store {
  id            String  @id @default(cuid())
  name          String
  address       String
  mobile        String
  landline      String?
  mapsUrl       String?
  mapsEmbedQuery String?
  photo         String?
  sortOrder     Int     @default(0)
  active        Boolean @default(true)

  @@map("stores")
}
